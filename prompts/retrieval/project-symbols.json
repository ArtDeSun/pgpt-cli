{
  "max_candidates": 12,
  "minimum_project_definition_score": 90,

  "identifier_shapes": {
    "allow_snake_case": true,
    "allow_dollar_identifiers": true,
    "allow_mixed_case": true,
    "allow_all_uppercase": false
  },

  "lexical": {
    "minimum_term_length": 4,
    "max_terms": 20,
    "stop_words": [
      "this",
      "that",
      "with",
      "from",
      "into",
      "while",
      "project",
      "application",
      "explain",
      "design",
      "review",
      "used",
      "current"
    ]
  }
}
