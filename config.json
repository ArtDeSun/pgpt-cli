{
  "version": 8,

  "endpoints": {
    "private_gpt": "http://127.0.0.1:8080",
    "ollama": "http://127.0.0.1:11434",
    "openai_api_base": "http://127.0.0.1:11434/v1"
  },

  "paths": {
    "private_gpt_dir": "~/ai/private-gpt",
    "pgpt_home": "~/ai/private-gpt-data",
    "chats_dir": "~/ai/pgpt-cli/chats",
    "responses_dir": "~/ai/pgpt-cli/responses",
    "state_dir": "~/ai/pgpt-cli/state",
    "secrets_file": "~/.config/pgpt/secrets.env"
  },

  "server": {
    "profiles": ["model", "web"]
  },

  "defaults": {
    "project": "vibemaster",
    "temperature": 0.1
  },

  "models": {
    "roles": {
      "router": "qwen3:1.7b",
      "general": "llama3.2:3b",
      "coder": "qwen2.5-coder:3b",
      "reasoning": "phi4-mini",

      "deep": "phi4-mini",

      "embedding": "qwen3-embedding:0.6b"
    },

    "coder_templates": ["debug", "implement", "explain-code"]
  },

  "routing": {
    "embedding_model": "qwen3-embedding:0.6b",
    "embedding_keep_alive": "30m",
    "embedding_timeout_seconds": 20,

    "thresholds": {
      "deep_similarity_min": 0.58,
      "deep_margin_min": 0.07,

      "source_margin_min": 0.035,
      "web_mode_margin_min": 0.03
    }
  },

  "retrieval": {
    "project_max_chars": 9000
  },

  "web": {
    "connectivity_host": "api.search.brave.com",
    "connectivity_port": 443,
    "connectivity_timeout_seconds": 0.7,

    "search_timeout_seconds": 6,
    "fetch_timeout_seconds": 5,

    "lookup_results": 3,
    "research_results": 6,

    "lookup_fetch_pages": 2,
    "research_fetch_pages": 3,

    "lookup_page_chars": 3500,
    "research_page_chars": 2500,

    "country": "CA",
    "search_lang": "en"
  },

  "history": {
    "messages": 8
  },

  "performance": {
    "request_timeout_seconds": 180,
    "final_keep_alive": "30m",

    "num_ctx_by_role": {
      "router": 1024,
      "general": 4096,
      "coder": 4096,
      "reasoning": 4096,

      "deep": 4096
    },

    "max_tokens_by_template": {
      "general": 700,
      "web-lookup": 700,
      "research-web": 1400,
      "explain-code": 900,
      "debug": 900,
      "implement": 1200,
      "architecture": 1400,
      "research": 1400
    }
  },

  "projects": {
    "vibemaster": {
      "source_dir": "~/dev/Professional-Viber-Web-App/my-app",
      "knowledge_dir": "~/ai/vibemaster-knowledge",
      "collection": "collection",

      "sync_excludes": [
        ".git/",
        "node_modules/",
        ".next/",
        ".env",
        ".env.*",
        "*.pem",
        "*.key"
      ],

      "ingest_ignored": [
        "optimize-landing-images.mjs",
        "favicon.ico",
        "AI_Generated_Basement_Studio.webp",
        "AI_Piano_Portrait.jpg",
        "treble-clef.png",
        "AI_Generated_Basement_Studio.png",
        "hero1.png",
        "Stay_In_Touch_Template.png",
        "hero2.png",
        "hero3.png",
        "icon.webp",
        "bass-clef.png",
        "MV_UI_Cards_Inspiration.png",
        "Signed_In_Dropdown.png",
        "icon.png",
        "vercel.svg",
        "window.svg",
        "next.svg",
        "file.svg",
        "globe.svg",
        "package-lock.json",
        ".gitignore"
      ]
    }
  }
}
