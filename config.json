{
  "version": 13,
  "endpoints": {
    "private_gpt": "http://127.0.0.1:8080",
    "ollama": "http://127.0.0.1:11434",
    "openai_api_base": "http://127.0.0.1:11434/v1"
  },
  "paths": {
    "private_gpt_dir": "~/ai/private-gpt",
    "pgpt_home": "~/ai/private-gpt-data",
    "chats_dir": "chats",
    "responses_dir": "responses",
    "state_dir": "state",
    "skills_dir": "~/.config/pgpt/skills",
    "projects_file": "~/.config/pgpt/projects.json",
    "secrets_file": "~/.config/pgpt/secrets.env"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8765,
    "max_request_bytes": 2000000,
    "response_list_limit": 100
  },
  "defaults": {
    "project": "pgpt-cli",
    "temperature": 0.1
  },
  "models": {
    "router": "qwen3:1.7b",
    "coder_templates": [
      "debug",
      "implement",
      "explain-code"
    ],
    "task_preferences": {
      "general": [
        "llama3.2:3b",
        "qwen2.5-coder:3b",
        "qwen3:1.7b"
      ],
      "research": [
        "llama3.2:3b",
        "qwen2.5-coder:3b",
        "qwen3:1.7b"
      ],
      "explain-code": [
        "qwen2.5-coder:3b",
        "llama3.2:3b",
        "qwen3:1.7b"
      ],
      "debug": [
        "qwen2.5-coder:3b",
        "llama3.2:3b",
        "qwen3:1.7b"
      ],
      "implement": [
        "qwen2.5-coder:3b",
        "llama3.2:3b",
        "qwen3:1.7b"
      ],
      "architecture": [
        "qwen2.5-coder:3b",
        "llama3.2:3b",
        "qwen3:1.7b"
      ]
    }
  },
  "retrieval": {
    "project_max_chars": 9000
  },
  "web": {
    "connectivity_host": "api.search.brave.com",
    "connectivity_port": 443,
    "connectivity_timeout_seconds": 0.7,
    "search_timeout_seconds": 6,
    "fetch_timeout_seconds": 4,
    "lookup_results": 3,
    "research_results": 6,
    "lookup_fetch_pages": 0,
    "research_fetch_pages": 3,
    "lookup_page_chars": 2500,
    "research_page_chars": 2500,
    "lookup_context_chars": 4500,
    "research_context_chars": 9000,
    "lookup_context_page_chars": 0,
    "research_context_page_chars": 900,
    "monthly_request_budget": 500,
    "budget_warning_ratio": 0.8,
    "country": "CA",
    "search_lang": "en"
  },
  "history": {
    "messages": 12,
    "mode": "auto"
  },
  "performance": {
    "request_timeout_seconds": 180,
    "final_keep_alive": "30m",
    "max_continuations": 2,
    "answer_lengths": {
      "short": 500,
      "standard": 1100,
      "long": 2000
    },
    "num_ctx_by_role": {
      "general": 4096,
      "coder": 4096,
      "deep": 6144
    },
    "max_tokens_by_template": {
      "general": 1000,
      "web-lookup": 700,
      "research-web": 1600,
      "explain-code": 1100,
      "debug": 1100,
      "implement": 1600,
      "architecture": 1800,
      "research": 1600
    }
  },
  "quality": {
    "judge_timeout_seconds": 360,
    "judge_num_ctx": 6144,
    "judge_max_tokens": 1000,
    "criterion_max_tokens": 32
  },
  "projects": {
    "pgpt-cli": {
      "source_dir": ".",
      "knowledge_dir": "~/ai/knowledge/pgpt-cli",
      "collection": "pgpt-cli",
      "sync_excludes": [
        ".git/",
        ".venv/",
        "__pycache__/",
        "responses/",
        "chats/",
        "state/",
        ".env",
        ".env.*",
        "*.pem",
        "*.key"
      ],
      "ingest_ignored": [
        ".gitignore",
        "secrets.env.example"
      ],
      "hidden": true
    },
    "pgpt-cli-history": {
      "source_dir": "tests/fixtures/historical_pgpt",
      "knowledge_dir": "~/ai/knowledge/pgpt-cli-history",
      "collection": "pgpt-cli-history",
      "sync_excludes": [],
      "ingest_ignored": [],
      "hidden": true
    }
  }
}
